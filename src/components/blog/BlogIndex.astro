---
import Base from "../../layouts/Base.astro";
import PostCard from "./PostCard.astro";
import { asLocale, useTranslations } from "../../i18n";
import { getPosts } from "../../lib/posts";

const locale = asLocale(Astro.currentLocale);
const t = useTranslations(locale);
const posts = await getPosts(locale);
---

<Base title={t("blog.title")} description={t("meta.blogDescription")}>
  <div class="container">
    <h1>{t("blog.title")}</h1>
    {
      posts.length === 0 ? (
        <p>{t("blog.empty")}</p>
      ) : (
        <ul class="list">
          {posts.map((entry) => (
            <li><PostCard entry={entry} locale={locale} /></li>
          ))}
        </ul>
      )
    }
  </div>
</Base>

<style>
  .container { padding-block: 2rem; }
  .list { list-style: none; padding: 0; display: grid; gap: 1rem; }
</style>

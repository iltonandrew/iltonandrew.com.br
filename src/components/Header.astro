---
import { asLocale, useTranslations, localePath, stripLocale, otherLocale } from "../i18n";

const locale = asLocale(Astro.currentLocale);
const t = useTranslations(locale);
const basePath = stripLocale(Astro.url.pathname);
const other = otherLocale(locale);
// The 404 page is one bilingual file, so its switcher points at the other locale's home.
const switchHref = localePath(other, basePath === "/404" ? "/" : basePath);
const switchLabel = locale === "pt-BR" ? "Switch to English" : "Mudar para Português";
const onBlog = basePath.startsWith("/blog");
const nav = [
  { href: localePath(locale, "/#about"), label: t("nav.about") },
  { href: localePath(locale, "/#work"), label: t("nav.work") },
  { href: localePath(locale, "/#projects"), label: t("nav.projects") },
  { href: localePath(locale, "/cv"), label: t("cv.title") },
  { href: "mailto:iltonandrew+contato@gmail.com", label: t("nav.contact") },
];
---

<header class="site-header">
  <div class="container bar">
    <a href={localePath(locale, "/")} class="brand" aria-label="Ilton Andrew — home">
      <img src="/fullname.svg" alt="" width="120" height="40" />
    </a>
    <nav aria-label="Main">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="actions">
      <a href={switchHref} class="icon-btn" aria-label={switchLabel} title={switchLabel} data-astro-reload>
        <img src={locale === "pt-BR" ? "/images/flags/us.png" : "/images/flags/br.png"} alt="" width="20" height="20" />
      </a>
      <button type="button" class="icon-btn" id="theme-toggle" aria-label="Toggle color theme">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
      <a href={onBlog ? localePath(locale, "/") : localePath(locale, "/blog")} class="btn btn-primary">
        {onBlog ? t("blog.home") : t("blog.title")}
      </a>
    </div>
  </div>
</header>

<script>
  // Theme toggle survives view transitions by re-binding on every page load.
  document.addEventListener("astro:page-load", () => {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    btn.addEventListener("click", () => {
      const root = document.documentElement;
      const next = root.dataset.theme === "light" ? "dark" : "light";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {}
    });
  });
  // Keep the chosen theme across view-transition swaps.
  document.addEventListener("astro:after-swap", () => {
    try {
      const t = localStorage.getItem("theme");
      if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
    } catch {}
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding-block: 0.75rem;
  }
  .brand img {
    display: block;
    width: 120px;
    height: auto;
  }
  /* Mobile: nav wraps to a second, horizontally scrollable row. No menu script needed. */
  nav {
    display: flex;
    gap: 1.25rem;
    flex: 1 0 100%;
    order: 3;
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
    padding-bottom: 0.25rem;
  }
  nav a {
    color: var(--fg);
    text-decoration: none;
    font-weight: 500;
  }
  nav a:hover {
    color: var(--accent);
  }
  .actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.5rem;
    border: none;
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }
  .icon-btn:hover {
    background: var(--bg-elev);
  }
  .icon-btn img {
    border-radius: 4px;
  }
  @media (min-width: 48rem) {
    nav {
      flex: 1;
      order: 0;
      overflow: visible;
      padding-bottom: 0;
    }
  }
</style>
